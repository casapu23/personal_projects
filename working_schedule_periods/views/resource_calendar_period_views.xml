<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="resource_calendar_period_view_list" model="ir.ui.view">
            <field name="name">resource.calendar.period.list</field>
            <field name="model">resource.calendar.period</field>
            <field name="arch" type="xml">
                <list string="Working Schedule Period">
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="resource_calendar_period_view_form" model="ir.ui.view">
            <field name="name">resource.calendar.period.form</field>
            <field name="model">resource.calendar.period</field>
            <field name="arch" type="xml">
                <form string="Working Schedule Period">
                    <group>
                        <field name="name"/>
                        <field name="company_id" placeholder="Visible to all"/>
                    </group>
                    <notebook>
                        <page string="Working schedules periods lines" name="period_lines">
                            <form>
                                <group>
                                    <field name="period_line_ids"/>
                                </group>
                            </form>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        
        <record id="resource_calendar_period_line_view_list" model="ir.ui.view">
            <field name="name">resource.calendar.period.line.list</field>
            <field name="model">resource.calendar.period.line</field>
            <field name="arch" type="xml">
                <list string="Working Schedule Period Lines">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="start_period"/>
                    <field name="end_period"/>
                    <field name="resource_calendar_id"/>
                </list>
            </field>
        </record>


        <record id="resource_calendar_period_line_view_form" model="ir.ui.view">
            <field name="name">resource.calendar.period.line.form</field>
            <field name="model">resource.calendar.period.line</field>
            <field name="arch" type="xml">
                <form string="Working Schedule Period Lines">
                    <group>
                        <field name="name"/>
                        <field name="start_period"/>
                        <field name="end_period"/>
                        <field name="resource_calendar_id"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="resource_calendar_period_action" model="ir.actions.act_window">
            <field name="name">Resource calendar periods</field>
            <field name="res_model">resource.calendar.period</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>