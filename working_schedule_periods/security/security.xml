<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Primero una 'ir.module.category' -->
<!-- Luego un 'res.groups.privilege' Nuevo de la versión 19 -->
<!-- Para acabar, un 'res.group' -->
    <record model="ir.module.category" id="module_category_custom_rights">
        <field name="name">Custom Rights</field>
        <field name="sequence">1</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_working_schedule_periods">
        <field name="name">Working Schedule Periods</field>
        <field name="category_id" ref="module_category_custom_rights"/>
    </record>

    <record id="working_schedule_periods_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_working_schedule_periods"/>
    </record>

    <record id="working_schedule_period_group_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_working_schedule_periods"/>
        <field name="implied_ids" eval="[(4, ref('working_schedule_periods.working_schedule_periods_group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="working_schedule_period_comp_rule" model="ir.rule">
        <field name="name">Working Schedule Periods multi-company</field>
        <field name="model_id" ref="model_resource_calendar_period"/>
        <field name="domain_force">['|',('company_id', 'in', company_ids),('company_id', '=', False)]</field>
    </record>
</odoo>